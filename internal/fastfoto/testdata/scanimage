#!/bin/sh
# A stand-in for SANE's scanimage: records its arguments, answers -L with
# the devices on the bench, and feeds FAKE_SIDES tiny sides into the
# --batch files, as the FF-680W does through the epsonds backend, each
# with the comment line scanimage writes in its header; FAKE_SIDE names a
# PNM to serve as every side instead.
echo "$*" >> "$FAKE_ARGS"
case "$*" in
*-L*)
	echo "device \`escl:https://10.0.0.81:443' is a ESCL H3-ET-2850 platen scanner"
	[ -n "$FAKE_NO_USB" ] || echo "device \`epsonds:libusb:001:004' is a Epson FF-680W ESC/I-2"
	[ -n "$FAKE_NO_NET" ] || echo "device \`epsonds:net:10.0.0.64' is a Epson FF-680W ESC/I-2"
	echo "device \`epson2:net:10.0.0.81' is a Epson PID flatbed scanner"
	exit 0 ;;
esac
pattern=""
prev=""
for arg in "$@"; do
	case "$arg" in
	--batch=*) pattern="${arg#--batch=}" ;;
	esac
	# the FF-680W's sources, each one argument, as the real scanimage wants
	if [ "$prev" = "--source" ] && [ "$arg" != "ADF Duplex" ] && [ "$arg" != "ADF Front" ]; then
		echo "scanimage: setting of option --source failed (Invalid argument)" >&2
		exit 1
	fi
	prev="$arg"
done
n=0
while [ "$n" -lt "${FAKE_SIDES:-0}" ]; do
	n=$((n + 1))
	echo "Scanning page $n"
	if [ -n "$FAKE_SIDE" ]; then
		cp "$FAKE_SIDE" "$(printf "$pattern" "$n")"
	else
		printf 'P6\n# SANE data follows\n2 1\n255\n\001\002\003\004\005\006' > "$(printf "$pattern" "$n")"
	fi
done
if [ "$n" -eq 0 ]; then
	echo "Scanning page 1"
	echo "scanimage: sane_start: Document feeder out of documents" >&2
fi
echo "Batch terminated, $n pages scanned"
exit 0
